<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= pageTitle %>
    </title>
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/organiser.css">
</head>

<body>
    <%- include('../partials/header', { currentPage: currentPage }) %>

        <main class="organiser-page">
            <section class="organiser-form-section">
                <h1>Organiser Edit Event Page</h1>
                <p class="event-created-date">
                    Created: <%= new Date(event.created_at).toLocaleDateString() %>
                </p>

                <form action="/organiser/event/<%= event.event_id %>/edit" method="POST" class="organiser-form">
                    <label for="event_title">Event title</label>
                    <input type="text" id="event_title" name="event_title" value="<%= event.event_title %>" required>

                    <label for="event_date">Event date</label>
                    <input type="date" id="event_date" name="event_date" value="<%= event.event_date %>" required>

                    <label for="event_description">Event description</label>
                    <textarea id="event_description" name="event_description"
                        rows="4"><%= event.event_description %></textarea>

                    <div class="ticket-field-group">
                        <div class="ticket-field">
                            <label for="full_price_ticket_qty">Full-price tickets available</label>
                            <input type="number" id="full_price_ticket_qty" name="full_price_ticket_qty"
                                value="<%= event.full_price_ticket_qty %>" min="0" required>
                        </div>

                        <div class="ticket-field">
                            <label for="full_price_ticket_price">Full-price ticket price (£)</label>
                            <input type="number" id="full_price_ticket_price" name="full_price_ticket_price"
                                value="<%= event.full_price_ticket_price %>" min="0" step="0.01" required>
                        </div>
                    </div>

                    <div class="ticket-field-group">
                        <div class="ticket-field">
                            <label for="concession_ticket_qty">Concession tickets available</label>
                            <input type="number" id="concession_ticket_qty" name="concession_ticket_qty"
                                value="<%= event.concession_ticket_qty %>" min="0" required>
                        </div>

                        <div class="ticket-field">
                            <label for="concession_ticket_price">Concession ticket price (£)</label>
                            <input type="number" id="concession_ticket_price" name="concession_ticket_price"
                                value="<%= event.concession_ticket_price %>" min="0" step="0.01" required>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="button primary-button">Submit Changes</button>
                    </div>
                </form>

                <a href="/organiser" class="button secondary-button small-button back-button">
                    &larr; Back to Organiser Home
                </a>
            </section>
        </main>

        <%- include('../partials/footer') %>
</body>

</html>